# Placeholders only. Production Render Free needs NO AI_BUDGET_FILE.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=production
SERVE_WEB=true
PORT=8080
TRUST_PROXY_HOPS=0
CORS_ORIGINS=
# Remain off until an OWNED FREE database is configured and initialized paused.
AI_ENABLED=false
AI_QUOTA_STORE=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_QUOTA_KEY=estudai:ai:quota:v1
AI_DAILY_PROVIDER_LIMIT=20
AI_DAILY_INPUT_BYTES=8388608
AI_DAILY_OUTPUT_TOKENS=65536
AI_PROVIDER_WINDOW_LIMIT=6
AI_MAX_CONCURRENT=1
# File mode is retained for local tests only; never use it as fallback on Render Free.
# AI_QUOTA_STORE=file
# AI_BUDGET_FILE=.local/ai-budget.json
